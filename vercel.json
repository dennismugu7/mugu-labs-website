{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/privacy",
      "destination": "https://app.mugu-labs.com/privacy",
      "permanent": false
    },
    {
      "source": "/privacy/",
      "destination": "https://app.mugu-labs.com/privacy",
      "permanent": false
    },
    {
      "source": "/terms",
      "destination": "https://app.mugu-labs.com/terms",
      "permanent": false
    },
    {
      "source": "/terms/",
      "destination": "https://app.mugu-labs.com/terms",
      "permanent": false
    }
  ]
}
